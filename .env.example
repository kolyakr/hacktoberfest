# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini

# fake = serve contracts/fixtures, real = the real implementation
AGENT_IMPL=fake       # api -> agent: fake answers from fixtures (real billing and webhooks), real = Yurko on OpenAI
TOOLS_IMPL=fake       # real agent -> tools: fake = fixtures, real = services/ BillingSim
DEMO_OVERCLAIM=0      # 1 = Yurko's first draft over-claims on purpose, so Zavuch's FIX shows on stage
BILLING_REFUND_DELAY_S=10  # seconds until the refund webhook; 20 for the demo video, so 🟡 shows before 🟢
STORE=memory          # memory, or supabase = mirror tickets, actions, audit_log for the console's Realtime

API_PORT=8000
MOCK_API_PORT=8001

# Supabase (STORE=supabase; the API writes with the service role, the browser reads with the anon key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
