{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push)", "Bash(git push *)", "Bash(make ship*)", "Bash(git reset --hard*)"
    ],
    "deny": [
      "Read(.env)", "Read(.env.*)", "Edit(.env)", "Edit(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lanes.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
